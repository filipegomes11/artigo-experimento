{
  "title": "Scheduler Latency",
  "uid": "scheduler-latency",
  "schemaVersion": 16,
  "version": 1,
  "panels": [
    {
      "title": "Scheduling Latency p95",
      "type": "graph",
      "targets": [
        {"expr": "histogram_quantile(0.95,sum(rate(scheduler_e2e_scheduling_duration_seconds_bucket[5m])) by (le))"}
      ]
    },
    {
      "title": "Pending Pods",
      "type": "graph",
      "targets": [
        {"expr": "sum(kube_pod_status_phase{phase=\"Pending\", namespace=\"app\"})"}
      ]
    }
  ]
}
